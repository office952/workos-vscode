# Local development only — copy to .env (gitignored) or set via scripts/start-dev.ps1
# Do NOT use these values in staging/production.

APP_ENV=development
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./dev.db
JWT_SECRET_KEY=local-dev-secret-not-for-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: OIDC for real login in dev (leave unset to use dev auth when frontend enables it)
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
