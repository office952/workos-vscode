{
  "task": "APP-AUTH-03",
  "version": "v1",
  "execution_mode_authorized": "OBSERVE_ONLY",
  "default_production": false,
  "default_dev_test": false,
  "activation_requires": "separate owner GO per phase",
  "flags": [
    {
      "flag": "parity_observe_enabled",
      "description": "Master switch — enables parity instrumentation pipeline in OBSERVE_ONLY",
      "default": false,
      "scope": "global",
      "phase": "P1+",
      "dependencies": []
    },
    {
      "flag": "competence_parity_enabled",
      "description": "P2 CompetenceParityEvaluator — registry vs legacy JSON",
      "default": false,
      "scope": "backend evaluators",
      "phase": "P1+",
      "dependencies": ["parity_observe_enabled"]
    },
    {
      "flag": "authorization_parity_enabled",
      "description": "P3 AuthorizationParityEvaluator — resource/workcenter/explicit",
      "default": false,
      "scope": "backend evaluators",
      "phase": "P1+",
      "dependencies": ["parity_observe_enabled"]
    },
    {
      "flag": "eligibility_shadow_enabled",
      "description": "P7 EligibilityShadowEvaluator — canonical simulation without response mutation",
      "default": false,
      "scope": "eligibility check hooks",
      "phase": "P2+",
      "dependencies": ["parity_observe_enabled", "competence_parity_enabled", "authorization_parity_enabled"]
    },
    {
      "flag": "legacy_fallback_tracking_enabled",
      "description": "LegacyFallbackUsageTracker — measure legacy/mock reads and writes",
      "default": false,
      "scope": "consumers + writers",
      "phase": "P1+",
      "dependencies": ["parity_observe_enabled"]
    },
    {
      "flag": "explicit_mapping_tracking_enabled",
      "description": "ExplicitMappingUsageTracker — classify explicit operation-employee usage",
      "default": false,
      "scope": "eligibility + mapping paths",
      "phase": "P1+",
      "dependencies": ["parity_observe_enabled"]
    },
    {
      "flag": "execution_surface_parity_enabled",
      "description": "P8 ExecutionSurfaceParityEvaluator — Mobile/Operator/Tablet/Shop Floor",
      "default": false,
      "scope": "cross-surface comparison jobs",
      "phase": "P3+",
      "dependencies": ["parity_observe_enabled", "eligibility_shadow_enabled"]
    },
    {
      "flag": "parity_persistence_enabled",
      "description": "Persist discrepancies to dedicated store (requires Gate I4 + migration GO)",
      "default": false,
      "scope": "persistence layer",
      "phase": "P4+",
      "dependencies": ["parity_observe_enabled"],
      "blocked_until": "Gate I4 owner GO"
    },
    {
      "flag": "parity_manager_projection_enabled",
      "description": "Manager reconciliation projection route (requires Gate I5)",
      "default": false,
      "scope": "manager report API",
      "phase": "P4+",
      "dependencies": ["parity_persistence_enabled"],
      "blocked_until": "Gate I5 owner GO"
    },
    {
      "flag": "parity_identity_parity_enabled",
      "description": "P1 EmployeeIdentityParityEvaluator",
      "default": false,
      "scope": "identity checks",
      "phase": "P1+",
      "dependencies": ["parity_observe_enabled"]
    },
    {
      "flag": "parity_workcenter_resource_enabled",
      "description": "P4+P5 WorkcenterParityEvaluator + ResourceParityEvaluator",
      "default": false,
      "scope": "catalog consumers",
      "phase": "P2+",
      "dependencies": ["parity_observe_enabled"]
    },
    {
      "flag": "parity_assignment_session_enabled",
      "description": "P9+P10 AssignmentWriterObserver + SessionParityEvaluator",
      "default": false,
      "scope": "assignment and session paths",
      "phase": "P3+",
      "dependencies": ["parity_observe_enabled"]
    },
    {
      "flag": "parity_attendance_compare_enabled",
      "description": "P11 AttendanceComparisonObserver — informative only",
      "default": false,
      "scope": "attendance vs execution",
      "phase": "P4+",
      "dependencies": ["parity_observe_enabled"]
    },
    {
      "flag": "parity_sandu_report_enabled",
      "description": "P12 ReconciliationReportService for employee Sandu",
      "default": false,
      "scope": "reconciliation report generation",
      "phase": "P1+",
      "dependencies": ["parity_observe_enabled", "competence_parity_enabled"]
    },
    {
      "flag": "parity_sampling_rate",
      "description": "Sampling rate 0.0-1.0 for high-cardinality comparisons (not a boolean)",
      "default": 0,
      "type": "float",
      "scope": "performance safeguard",
      "phase": "P3+",
      "dependencies": ["parity_observe_enabled"]
    },
    {
      "flag": "parity_circuit_breaker_enabled",
      "description": "Disable shadow evaluation when latency budget exceeded",
      "default": false,
      "scope": "performance safeguard",
      "phase": "P2+",
      "dependencies": ["parity_observe_enabled"]
    }
  ],
  "modes_not_authorized": [
    "COMPARE_AND_WARN",
    "ENFORCE_CANONICAL"
  ]
}
