# WorkOS root environment example
# Safe placeholders only. Do not commit real secrets.

# Frontend local preview
VITE_ENABLE_DEV_AUTH=false
VITE_API_BASE_URL=
VITE_DEV_GUARD_BYPASS=false
VITE_DEV_GUARD_ALLOWLIST=
BACKEND_PORT=8001
VITE_PORT=3000

# Backend local runtime
APP_ENV=development
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./backend/dev.db
JWT_SECRET_KEY=replace-me-local-only
DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional real auth in non-mock local environments
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
WORKOS_DEV_AUTH_USER_ID=